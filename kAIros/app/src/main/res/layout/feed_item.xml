<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <View
            android:layout_width="300dp"
            android:layout_height="2dp"
            android:background="@color/teal_700"
            android:layout_gravity="center"
            android:layout_marginBottom="16dp"/>

        <!-- Imagen (solo se muestra si existe en la publicación) -->
        <ImageView
            android:id="@+id/imageFeed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/imagen_generada_por_ia"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!-- Texto de la entrada -->
        <TextView
            android:id="@+id/textFeedContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:textSize="16sp"
            android:textColor="#000000" />

        <!-- Botones de acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="8dp">

            <!-- Botón de like -->
            <ImageButton
                android:id="@+id/buttonLike"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/entry_feed_robotichand"
                android:contentDescription="@string/like"
                app:tint="@android:color/black" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="16dp" />

            <!-- Botón de guardar -->
            <ImageButton
                android:id="@+id/buttonSave"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/entry_feed_save"
                android:contentDescription="@string/like"
                app:tint="@android:color/black" />

            <!-- Espacio -->
            <View
                android:layout_width="16dp"
                android:layout_height="wrap_content" />

            <!-- Botón de comentar -->
            <ImageButton
                android:id="@+id/buttonComment"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/entry_feed_comment"
                android:contentDescription="@string/comentar"
                app:tint="@android:color/black" />
        </LinearLayout>

        <!-- Contenedor para comentarios -->
        <LinearLayout
            android:id="@+id/commentsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:padding="8dp">

            <EditText
                android:id="@+id/editTextComment"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/escribe_un_comentario"
                android:inputType="textMultiLine" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
